* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    color: #263238;
    background-color: #f4f6f8;
}

/* Link para pular ao conteúdo */
.pular {
    position: absolute;
    top: -100px;
    left: 10px;
    padding: 10px;
    color: white;
    background: #123c69;
}

.pular:focus {
    top: 10px;
}

/* Cabeçalho */
header {
    padding: 35px 20px;
    text-align: center;
    color: white;
    background: #123c69;
}

header h1 {
    margin-bottom: 10px;
    font-size: 2.2rem;
}

/* Menu */
nav ul {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
    list-style: none;
}

nav a {
    color: white;
    font-weight: bold;
    text-decoration: none;
}

nav a:hover {
    text-decoration: underline;
}

/* Conteúdo */
main {
    max-width: 1100px;
    margin: 30px auto;
    padding: 0 20px;
}

section {
    margin-bottom: 25px;
    padding: 25px;
    background: white;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

h2 {
    margin-bottom: 20px;
    color: #123c69;
}

h3 {
    margin-bottom: 12px;
    color: #245b8f;
}

article {
    padding: 20px 0;
    border-bottom: 1px solid #ddd;
}

article:last-child {
    border-bottom: none;
}

/* Imagens */
figure {
    margin: 15px 0;
}

figure img {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    margin: auto;
    border-radius: 8px;
}

figcaption {
    margin-top: 8px;
    text-align: center;
    color: #52616b;
}

/* Tabela */
table {
    width: 100%;
    border-collapse: collapse;
}

caption {
    margin-bottom: 10px;
    font-weight: bold;
}

th, td {
    padding: 12px;
    border: 1px solid #cbd5df;
    text-align: left;
}

thead {
    color: white;
    background: #123c69;
}

tbody th {
    background: #eaf0f6;
}

/* Listas */
section ul {
    padding-left: 25px;
}

/* Formulário */
fieldset {
    padding: 20px;
    border: 1px solid #cbd5df;
    border-radius: 8px;
}

legend {
    padding: 0 8px;
    color: #123c69;
    font-weight: bold;
}

.campo {
    margin-bottom: 16px;
}

label {
    display: block;
    margin-bottom: 6px;
    font-weight: bold;
}

input, select, textarea {
    width: 100%;
    padding: 11px;
    border: 1px solid #aebbc8;
    border-radius: 5px;
    font: inherit;
}

button {
    margin-top: 15px;
    padding: 12px 22px;
    color: white;
    background: #123c69;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background: #245b8f;
}

/* Conteúdo complementar */
aside {
    max-width: 1060px;
    margin: 25px auto;
    padding: 25px;
    background: #e5edf5;
    border-left: 5px solid #245b8f;
}

aside a {
    color: #123c69;
    font-weight: bold;
}

/* Rodapé */
footer {
    padding: 25px;
    text-align: center;
    color: white;
    background: #123c69;
}

footer address {
    font-style: normal;
}

/* Responsividade */
@media (max-width: 700px) {
    header h1 {
        font-size: 1.8rem;
    }

    nav ul {
        flex-direction: column;
        gap: 10px;
    }

    section {
        padding: 18px;
    }

    table {
        font-size: 0.85rem;
    }

    th, td {
        padding: 8px;
    }

    aside {
        margin: 20px;
    }
}